<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="680.0" prefWidth="1100.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.test.laboratorioorm.controller.EquipoController">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Control de equipos de laboratorio" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <!-- FORMULARIO -->
                <GridPane hgap="10.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="70.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                        <ColumnConstraints minWidth="70.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" />
                    </rowConstraints>
                    <children>
                        <Label text="Código:" textFill="#34495e" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtCodigo" promptText="Ej. EQ-009" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Nombre:" textFill="#34495e" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Marca:" textFill="#34495e" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtMarca" promptText="Marca" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Cantidad:" textFill="#34495e" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtCantidad" promptText="0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="Tipo:" textFill="#34495e" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccione un tipo" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Estado:" textFill="#34495e" GridPane.columnIndex="2" GridPane.rowIndex="2">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione un estado" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                    </children>
                </GridPane>

                <!-- BOTONES CRUD -->
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarEquipo" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarEquipo" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-cursor: hand;" text="Actualizar" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarEquipo" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;" text="Eliminar" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarCampos" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar" />
                    </children>
                </HBox>

                <Separator />

                <!-- BÚSQUEDA Y FILTRO -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Buscar por nombre:" textFill="#34495e">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtBuscar" prefWidth="220.0" promptText="Ej. laptop" />

                        <Label text="Filtrar por tipo:" textFill="#34495e">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbFiltroTipo" prefWidth="180.0" promptText="Todos" />

                        <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#aplicarFiltros" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;" text="Buscar / Aplicar filtros" />
                        <Button fx:id="btnMostrarTodos" mnemonicParsing="false" onAction="#mostrarTodos" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Mostrar todos" />
                    </children>
                </HBox>

                <Label text="Seleccione un equipo de la tabla para actualizarlo o eliminarlo.">
                    <font><Font name="System Italic" size="11.0" /></font>
                </Label>

                <!-- TABLA -->
                <TableView fx:id="tblEquipos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colMarca" prefWidth="120.0" text="Marca" />
                        <TableColumn fx:id="colEstado" prefWidth="140.0" text="Estado" />
                        <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cantidad" />
                        <TableColumn fx:id="colTipo" prefWidth="160.0" text="Tipo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>